NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# AbacatePay: chave de API, SOMENTE no servidor (sem prefixo NEXT_PUBLIC). abc_dev_ = teste, abc_prod_ = real
ABACATEPAY_API_KEY=abc_dev_...

# Resend: chave de API para e-mails enviados pelo servidor, SOMENTE no servidor
RESEND_API_KEY=re_...

# Supabase: chave SECRETA (sb_secret_...), SOMENTE no servidor. Ignora as regras de acesso do banco.
NEXT_SUPABASE_SECRET_KEY=sb_secret_...

# E-mails (opcional): remetente em um domínio verificado no Resend
EMAIL_FROM=ProBarber <no-reply@probarberapp.com.br>
